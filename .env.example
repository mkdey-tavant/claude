# Copy to .env and adjust as needed. All values are optional; sane defaults apply.

# Logging: DEBUG | INFO | WARNING | ERROR
SAM_LOG_LEVEL=INFO

# Cache time-to-live in seconds for price/fundamental data (reduces yfinance calls)
SAM_CACHE_TTL_SECONDS=900

# Max entries held in the in-memory cache
SAM_CACHE_MAXSIZE=256

# Default market to assume when a bare symbol is given (NSE | BSE)
SAM_DEFAULT_MARKET=NSE

# Retry attempts for transient yfinance/network failures
SAM_MAX_RETRIES=3

# Default lookback window (in days) for historical price analysis
SAM_HISTORY_DAYS=400

# Risk-free rate (annualized, decimal) used for Sharpe ratio. India 10Y G-Sec ~ 0.07
SAM_RISK_FREE_RATE=0.07

# --- Web dashboard only (webui/app.py) ---
# These are read from the shell environment (not this .env file). Prefer the --port /
# --host flags, or `export` these before launching:  export SAM_WEBUI_PORT=5002
# SAM_WEBUI_PORT=5001
# SAM_WEBUI_HOST=127.0.0.1
